/* Dark Theme QSS */

QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
}

QMainWindow {
    background-color: #1e1e1e;
}

QMenuBar {
    background-color: #252525;
    color: #e0e0e0;
    border-bottom: 1px solid #3d3d3d;
}

QMenuBar::item:selected {
    background-color: #3d3d3d;
}

QMenu {
    background-color: #252525;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
}

QMenu::item:selected {
    background-color: #3d3d3d;
}

QToolBar {
    background-color: #252525;
    border: 1px solid #3d3d3d;
}

QToolButton {
    background-color: #252525;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    border-radius: 3px;
    padding: 4px;
}

QToolButton:hover {
    background-color: #3d3d3d;
}

QToolButton:pressed {
    background-color: #1e1e1e;
}

QPushButton {
    background-color: #0e639c;
    color: #e0e0e0;
    border: 1px solid #007acc;
    border-radius: 3px;
    padding: 5px 15px;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #007acc;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #6e6e6e;
    border: 1px solid #3d3d3d;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #007acc;
}

QLineEdit, QTextEdit, QPlainTextEdit, QTextBrowser {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    border-radius: 3px;
    padding: 4px;
}

QTextEdit:disabled, QTextBrowser:disabled {
    background-color: #1e1e1e;
    color: #6e6e6e;
}

QComboBox {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    border-radius: 3px;
    padding: 4px;
}

QComboBox:focus {
    border: 1px solid #007acc;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
}

QSpinBox, QDoubleSpinBox {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    border-radius: 3px;
    padding: 4px;
}

QCheckBox, QRadioButton {
    color: #e0e0e0;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3d3d3d;
    border-radius: 2px;
    background-color: #2d2d2d;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #007acc;
    border: 1px solid #007acc;
}

QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #3d3d3d;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555555;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #3d3d3d;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #555555;
}

QHeaderView::section {
    background-color: #252525;
    color: #e0e0e0;
    padding: 5px;
    border: none;
    border-right: 1px solid #3d3d3d;
}

QTableWidget, QListWidget, QTreeWidget {
    background-color: #2d2d2d;
    color: #e0e0e0;
    gridline-color: #3d3d3d;
    border: 1px solid #3d3d3d;
}

QTableWidget::item:selected, QListWidget::item:selected, QTreeWidget::item:selected {
    background-color: #0e639c;
}

QTabBar::tab {
    background-color: #252525;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    padding: 6px 12px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    border-bottom: 2px solid #007acc;
}

QTabWidget::pane {
    border: 1px solid #3d3d3d;
}

QStatusBar {
    background-color: #252525;
    color: #e0e0e0;
    border-top: 1px solid #3d3d3d;
}

QDockWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
}

QDockWidget::title {
    background-color: #252525;
    padding: 4px;
}

QGroupBox {
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
}

QLabel {
    color: #e0e0e0;
}

QProgressBar {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #3d3d3d;
    border-radius: 3px;
}

QProgressBar::chunk {
    background-color: #007acc;
}

QSlider::groove:horizontal {
    background-color: #3d3d3d;
    height: 8px;
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background-color: #007acc;
    width: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #0e639c;
}

QComboBox::down-arrow {
    image: url(assets/arrow-down-white.svg);
    width: 12px;
    height: 12px;
}